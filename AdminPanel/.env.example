# Kopyalayın: cp .env.example .env.local   (canlıda bu değerler barındırma panelinin "Environment" ayarlarına girilir)

# JWT imzalama anahtarı. Üretin: openssl rand -hex 32   — Üretimde zorunlu; her ortamda farklı olmalı.
# Değiştirilirse tüm oturumlar (panel + uygulama) düşer.
AUTH_SECRET=

# ---------------------------------------------------------------- veritabanı
# Yalnızca yerel Docker için (docker-compose.yml bu şifreyle veritabanını oluşturur). Üretin: openssl rand -hex 16
POSTGRES_PASSWORD=
# Uygulamanın bağlandığı adres: postgres://KULLANICI:ŞİFRE@SUNUCU:PORT/VERİTABANI
#   Yerel: postgres://fb_app:<POSTGRES_PASSWORD>@localhost:5432/fenbahceleri
#   Canlı: yönetilen PostgreSQL sağlayıcısının verdiği bağlantı adresi
DATABASE_URL=
# Canlıda (yönetilen PostgreSQL) true. Yerelde false.
DATABASE_SSL=false
# İsteğe bağlı: bağlantı havuzu boyutu (varsayılan 10)
# DATABASE_POOL_MAX=10
# Boş veritabanına örnek veri eklensin mi? Varsayılan: geliştirmede evet, üretimde hayır. CANLIDA true YAPMAYIN.
# SEED_SAMPLE_DATA=true

# ---------------------------------------------------------------- uygulama
# true: öğrenci okutmalarında kioskun BLE jetonu zorunlu. Prototip ölçümlerinden sonra açın.
BLE_REQUIRED=false

# mock: SMS gönderilmez, yalnızca kaydedilir. (Gerçek sağlayıcı 2. aşamada.)
SMS_PROVIDER=mock
SCHOOL_SHORT_NAME="Fen Bahceleri"

# `npm start` ile http://localhost üzerinden denerken Safari'de oturum çerezinin çalışması için false yapın.
# HTTPS arkasında (tünel veya gerçek sunucu) true bırakın.
COOKIE_SECURE=true
