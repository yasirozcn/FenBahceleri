# Kopyalayın: cp .env.example .env   (bu dosya git'e girmez)

# Sunucunun adresi. Alan adınız yoksa Lightsail statik IP'sinden üretin:
#   IP 3.121.45.67 ise → 3-121-45-67.sslip.io
DOMAIN=

# Üretin: openssl rand -hex 32   (yereldekinden FARKLI olmalı)
AUTH_SECRET=
# Üretin: openssl rand -hex 24   (ilk kurulumdan sonra değiştirmeyin; veritabanı bu şifreyle oluşur)
POSTGRES_PASSWORD=

# true: okutmada kiosk Bluetooth jetonu zorunlu
BLE_REQUIRED=false
SMS_PROVIDER=mock
SCHOOL_SHORT_NAME=Fen Bahceleri
